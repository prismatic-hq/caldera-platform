{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "environment",
    "datasetVersion",
    "domain",
    "gateway",
    "image",
    "services",
    "postgres",
    "serviceDefaults"
  ],
  "definitions": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "image"
      ],
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "migration": {
          "$ref": "#/definitions/migration"
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "properties": {
    "environment": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "datasetVersion": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "priorityClassName": {
      "type": "string"
    },
    "gateway": {
      "type": "object",
      "required": [
        "name",
        "namespace",
        "sectionName"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "sectionName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "services": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/service"
      }
    },
    "postgres": {
      "type": "object",
      "required": [
        "image",
        "database",
        "user",
        "uid",
        "resources"
      ],
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "database": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "user": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "uid": {
          "type": "integer",
          "minimum": 1
        },
        "memoryBacked": {
          "type": "boolean"
        },
        "sizeLimit": {
          "type": "string"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "serviceDefaults": {
      "type": "object",
      "required": [
        "port",
        "resources",
        "migration"
      ],
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "migration": {
          "allOf": [
            {
              "$ref": "#/definitions/migration"
            },
            {
              "required": [
                "enabled",
                "command",
                "timeoutSeconds"
              ]
            }
          ]
        }
      }
    },
    "routeLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "service": {
      "type": "object"
    }
  }
}

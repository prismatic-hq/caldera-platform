{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prismatic-hq/caldera-platform/blob/main/contracts/events/data/vent.environment.cooled.v1.schema.json",
  "title": "vent.environment.cooled.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vent",
    "trigger",
    "timings"
  ],
  "properties": {
    "vent": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 48
    },
    "trigger": {
      "enum": [
        "branch-deleted",
        "sweeper",
        "manual"
      ]
    },
    "timings": {
      "type": "object",
      "description": "Stage durations in seconds (REQUIREMENTS.md Section 1)",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    }
  }
}

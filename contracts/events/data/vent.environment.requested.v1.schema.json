{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prismatic-hq/caldera-platform/blob/main/contracts/events/data/vent.environment.requested.v1.schema.json",
  "title": "vent.environment.requested.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vent",
    "repo",
    "branch",
    "sha",
    "services",
    "datasetVersion"
  ],
  "properties": {
    "vent": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 48
    },
    "repo": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "image"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "datasetVersion": {
      "type": "string",
      "minLength": 1
    }
  }
}
